# Copy this file to .env and fill in whatever you want to use — everything
# here is optional and the app runs fine with none of it set.

# Enables LLM-assisted parsing in parser.py. Falls back to offline regex
# parsing if unset.
ANTHROPIC_API_KEY=

# Enables Postgres persistence (db.py, schema.sql). App runs fine without it.
DATABASE_URL=postgresql://user:password@localhost:5432/nz_biz_analyzer

# Alert webhooks (alerts.py) — configure any subset. Fires when a listing's
# composite score clears ALERT_COMPOSITE_MIN in config.py.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
